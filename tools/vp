#!/usr/bin/env bash

set -uo pipefail

MODE="${1:-deep}"
shift || true

REPO=""
while [[ $# -gt 0 ]]; do
    case "$1" in
        --repo)
            REPO="${2:-}"
            shift 2
            ;;
        *)
            shift
            ;;
    esac
done

HOME_ROOT="$HOME/.velma-preflight"
VENV="$HOME_ROOT/venv"
RESULTS="$HOME_ROOT/results"
WORKROOT="$HOME_ROOT/work"

PY="$VENV/bin/python"
PYTEST="$VENV/bin/pytest"
RUFF="$VENV/bin/ruff"
PYRIGHT="$VENV/bin/pyright"
CROSSHAIR="$VENV/bin/crosshair"
MUTMUT="$VENV/bin/mutmut"
PIPAUDIT="$VENV/bin/pip-audit"

mkdir -p "$RESULTS" "$WORKROOT"

# ============================================================
# STATUS
# ============================================================

if [[ "$MODE" == "status" ]]; then
    if [[ -L "$HOME_ROOT/latest" && -f "$HOME_ROOT/latest/SUMMARY.txt" ]]; then
        cat "$HOME_ROOT/latest/SUMMARY.txt"
        exit 0
    fi

    echo "No VELMA preflight run has been recorded yet."
    exit 1
fi

# ============================================================
# DOCTOR
# ============================================================

if [[ "$MODE" == "doctor" ]]; then

    FAIL=0

    check_tool() {
        local label="$1"
        local path="$2"

        if [[ -x "$path" ]]; then
            echo "PASS  $label"
        else
            echo "FAIL  $label"
            FAIL=1
        fi
    }

    echo
    echo "VELMA TEST-2 PREFLIGHT DOCTOR"
    echo "========================================"

    check_tool Python "$PY"
    check_tool pytest "$PYTEST"
    check_tool Ruff "$RUFF"
    check_tool Pyright "$PYRIGHT"
    check_tool CrossHair "$CROSSHAIR"
    check_tool mutmut "$MUTMUT"
    check_tool pip-audit "$PIPAUDIT"

    command -v git >/dev/null 2>&1 \
        && echo "PASS  git" \
        || { echo "FAIL  git"; FAIL=1; }

    command -v curl >/dev/null 2>&1 \
        && echo "PASS  curl" \
        || { echo "FAIL  curl"; FAIL=1; }

    command -v jq >/dev/null 2>&1 \
        && echo "PASS  jq" \
        || { echo "FAIL  jq"; FAIL=1; }

    command -v rustc >/dev/null 2>&1 \
        && echo "PASS  rustc" \
        || { echo "FAIL  rustc"; FAIL=1; }

    command -v cargo >/dev/null 2>&1 \
        && echo "PASS  cargo" \
        || { echo "FAIL  cargo"; FAIL=1; }

    echo

    if [[ "$FAIL" -eq 0 ]]; then
        echo "VP DOCTOR: PASS"
        exit 0
    else
        echo "VP DOCTOR: BLOCKED"
        exit 1
    fi
fi

if [[ "$MODE" != "fast" && "$MODE" != "deep" ]]; then
    echo "Usage:"
    echo "  vp doctor"
    echo "  vp fast"
    echo "  vp deep"
    echo "  vp status"
    exit 2
fi

# ============================================================
# FIND SOURCE REPOSITORY
# ============================================================

if [[ -z "$REPO" ]]; then
    REPO="$(git rev-parse --show-toplevel 2>/dev/null || true)"
fi

if [[ -z "$REPO" || ! -d "$REPO/.git" ]]; then
    echo "TIER-A PREFLIGHT: BLOCKED"
    echo "Reason: run vp from inside the inverted repository."
    exit 2
fi

SHA="$(git -C "$REPO" rev-parse HEAD)"
SHORT="${SHA:0:12}"
BRANCH="$(git -C "$REPO" branch --show-current)"
ORIGIN="$(git -C "$REPO" remote get-url origin 2>/dev/null || true)"

STAMP="$(date -u +%Y%m%dT%H%M%SZ)"
OUT="$RESULTS/${STAMP}-${SHORT}"
WORK="$WORKROOT/${STAMP}-${SHORT}"
CLONE="$WORK/repo"

mkdir -p "$OUT" "$WORK"

BLOCKED=0
WARNINGS=0
BLOCKERS_FILE="$OUT/BLOCKERS.txt"
WARNINGS_FILE="$OUT/WARNINGS.txt"

: > "$BLOCKERS_FILE"
: > "$WARNINGS_FILE"

block() {
    local reason="$1"
    echo "$reason" >> "$BLOCKERS_FILE"
    echo "BLOCK  $reason"
    BLOCKED=1
}

warn() {
    local reason="$1"
    echo "$reason" >> "$WARNINGS_FILE"
    echo "WARN   $reason"
    WARNINGS=$((WARNINGS + 1))
}

run_gate() {
    local name="$1"
    shift

    echo
    echo "============================================================"
    echo "$name"
    echo "============================================================"

    set +e
    "$@" 2>&1 | tee "$OUT/${name}.log"
    local rc=${PIPESTATUS[0]}
    set -e 2>/dev/null || true
    set +e

    echo "$rc" > "$OUT/${name}.exit"

    if [[ "$rc" -ne 0 ]]; then
        block "$name"
    else
        echo "PASS  $name"
    fi

    return 0
}

run_advisory() {
    local name="$1"
    shift

    echo
    echo "------------------------------------------------------------"
    echo "$name"
    echo "------------------------------------------------------------"

    set +e
    "$@" 2>&1 | tee "$OUT/${name}.log"
    local rc=${PIPESTATUS[0]}
    set +e

    echo "$rc" > "$OUT/${name}.exit"

    if [[ "$rc" -ne 0 ]]; then
        warn "$name"
    else
        echo "PASS  $name"
    fi

    return 0
}

# ============================================================
# RECORD SOURCE STATE
# ============================================================

cat > "$OUT/source.txt" <<EOF
mode=$MODE
sha=$SHA
branch=$BRANCH
origin=$ORIGIN
source_repo=$REPO
utc_start=$STAMP
EOF

# ============================================================
# WINDOWS-SOURCE WORKTREE AUTHORITY
# ============================================================
#
# REPO is a Windows checkout mounted through /mnt/c.
# Windows Git is authoritative for its worktree semantics.
# WSL Git must NOT classify CRLF-normalized Windows files as dirty.

git -C "$REPO" log -1 --format=fuller > "$OUT/commit.txt"

WIN_REPO="$(wslpath -w "$REPO")"

printf '%s\n' "$WIN_REPO" |
    powershell.exe -NoProfile -Command '
$ErrorActionPreference = "Stop"
$r = [Console]::In.ReadLine()
if (-not $r) {
    Write-Error "Missing Windows repository path"
    exit 90
}

& git -C $r status --porcelain=v1
if ($LASTEXITCODE -ne 0) {
    exit $LASTEXITCODE
}
' 2>&1 | tr -d '\r' > "$OUT/source-dirty.txt"

ps_status=${PIPESTATUS[1]}

if [[ "$ps_status" -ne 0 ]]; then
    cat "$OUT/source-dirty.txt"
    block "source_git_status_unavailable"
else
    printf '%s\n' "$WIN_REPO" |
        powershell.exe -NoProfile -Command '
$ErrorActionPreference = "Stop"
$r = [Console]::In.ReadLine()
if (-not $r) {
    Write-Error "Missing Windows repository path"
    exit 90
}

$paths = New-Object System.Collections.Generic.List[string]

foreach ($line in (& git -C $r diff --name-only)) {
    [void]$paths.Add($line)
}
if ($LASTEXITCODE -ne 0) { exit $LASTEXITCODE }

foreach ($line in (& git -C $r diff --cached --name-only)) {
    [void]$paths.Add($line)
}
if ($LASTEXITCODE -ne 0) { exit $LASTEXITCODE }

foreach ($line in (& git -C $r ls-files --others --exclude-standard)) {
    [void]$paths.Add($line)
}
if ($LASTEXITCODE -ne 0) { exit $LASTEXITCODE }

$paths | Sort-Object -Unique
' 2>&1 | tr -d '\r' > "$OUT/source-dirty-paths.txt"

    path_status=${PIPESTATUS[1]}

    if [[ "$path_status" -ne 0 ]]; then
        cat "$OUT/source-dirty-paths.txt"
        block "source_git_status_unavailable"
    else
        "$PY" - "$OUT/source-dirty-paths.txt" > "$OUT/source-dirty-relevance.txt" <<'PY'
from pathlib import Path
import sys

source = Path(sys.argv[1])

dirty = {
    line.strip()
    for line in source.read_text(
        encoding="utf-8",
        errors="replace",
    ).splitlines()
    if line.strip()
}


def generated(path: str) -> bool:
    parts = Path(path).parts

    return (
        "__pycache__" in parts
        or path.endswith((".pyc", ".pyo"))
        or path.startswith("src/inverted_ai_benchmark.egg-info/")
        or path.startswith("build/")
        or path.startswith(".pytest_cache/")
        or path.startswith(".hypothesis/")
        or path.startswith(".ruff_cache/")
        or path.startswith("htmlcov/")
        or path == ".coverage"
        or path.startswith(".coverage.")
    )


ignored = sorted(
    path
    for path in dirty
    if generated(path)
)

relevant = sorted(
    path
    for path in dirty
    if not generated(path)
)

print("WINDOWS GIT DIRTY CLASSIFICATION")
print("=" * 48)

print("\nIGNORED / GENERATED:")
for path in ignored:
    print(path)

print("\nTIER-A RELEVANT:")
for path in relevant:
    print(path)

if relevant:
    raise SystemExit(1)

print("\nSOURCE EXACT-SHA SAFETY: PASS")
PY

        if [[ $? -ne 0 ]]; then
            cat "$OUT/source-dirty-relevance.txt"
            block "source_git_tree_dirty"
        else
            cat "$OUT/source-dirty-relevance.txt"
        fi
    fi
fi

# ============================================================
# HOST / WSL SNAPSHOT
# ============================================================

uname -a > "$OUT/wsl-kernel.txt"
df -h > "$OUT/wsl-disk.txt"
free -h > "$OUT/wsl-memory.txt"

"$PY" --version > "$OUT/python-version.txt" 2>&1
git --version > "$OUT/git-version.txt" 2>&1

if command -v powershell.exe >/dev/null 2>&1; then

    powershell.exe -NoProfile -Command '
        Get-CimInstance Win32_OperatingSystem |
        Select-Object Caption,Version,BuildNumber,TotalVisibleMemorySize,FreePhysicalMemory |
        Format-List
    ' 2>&1 | tr -d '\r' > "$OUT/windows-os.txt"

    powershell.exe -NoProfile -Command '
        Get-CimInstance Win32_VideoController |
        Select-Object Name,DriverVersion,AdapterRAM |
        Format-List
    ' 2>&1 | tr -d '\r' > "$OUT/windows-gpu.txt"
fi

# ============================================================
# EXACT IMMUTABLE EXT4 CLONE
# ============================================================

echo
echo "Creating disposable exact-SHA WSL/ext4 clone..."

if ! git clone --no-hardlinks --quiet "$REPO" "$CLONE"; then
    block "cannot_clone_source_into_wsl_ext4"
else
    if ! git -C "$CLONE" checkout --detach --quiet "$SHA"; then
        block "cannot_checkout_exact_sha"
    fi
fi

if [[ ! -d "$CLONE/.git" ]]; then
    block "scratch_clone_missing"
fi

if [[ "$BLOCKED" -eq 0 || -d "$CLONE/.git" ]]; then

    CLONE_SHA="$(git -C "$CLONE" rev-parse HEAD 2>/dev/null || true)"

    if [[ "$CLONE_SHA" != "$SHA" ]]; then
        block "scratch_clone_sha_mismatch"
    fi

    if [[ -n "$(git -C "$CLONE" status --porcelain=v1 2>/dev/null)" ]]; then
        block "scratch_clone_not_clean_before_audit"
    fi
fi

# ============================================================
# INSTALL EXACT PROJECT INTO AUDIT ENV
# ============================================================

if [[ -d "$CLONE" ]]; then

    "$PY" -m pip install -q "${CLONE}[test]" \
        > "$OUT/project-install.log" 2>&1

    if [[ $? -ne 0 ]]; then
        block "project_dependency_install"
    fi
fi

cd "$CLONE" || exit 2

# ============================================================
# SCIENTIFIC CONSTITUTION / CONFIG GATE
# ============================================================

"$PY" - <<'PY' > "$OUT/scientific-contract.txt" 2>&1

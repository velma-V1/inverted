# ============================================================
# GITHUB EXACT-SHA WORKFLOW GATE
# ============================================================

"$PY" - "$ORIGIN" "$SHA" <<'PY' > "$OUT/github-ci.txt" 2>&1
import json
import re
import subprocess
import sys
import urllib.error
import urllib.request

origin, sha = sys.argv[1], sys.argv[2]

m = re.search(
    r"github\.com[:/](?P<repo>[^/\]]+/[^/\]\)]+?)(?:\.git)?(?:\]|\)|$)",
    origin,
)

if not m:
    raise SystemExit(
        f"Could not derive GitHub repository from origin: {origin!r}"
    )

repo = m.group("repo").removesuffix(".git")


def windows_github_token() -> str:
    ps = r"""
$ErrorActionPreference = "Stop"
$inputText = "protocol=https`nhost=github.com`n`n"
$cred = $inputText | git credential fill
$line = $cred |
    Where-Object { $_ -like "password=*" } |
    Select-Object -First 1

if (-not $line) {
    exit 3
}

$line.Substring(9)
"""

    proc = subprocess.run(
        ["powershell.exe", "-NoProfile", "-Command", ps],
        text=True,
        capture_output=True,
        timeout=20,
    )

    if proc.returncode != 0:
        raise RuntimeError(
            "Windows Git credential lookup failed."
        )

    token = proc.stdout.strip()

    if not token:
        raise RuntimeError(
            "Windows Git credential contained no password/token."
        )

    return token


token = windows_github_token()

url = (
    f"https://api.github.com/repos/{repo}/actions/runs"
    f"?head_sha={sha}&per_page=100"
)

req = urllib.request.Request(
    url,
    headers={
        "User-Agent": "velma-test2-preflight",
        "Accept": "application/vnd.github+json",
        "Authorization": f"Bearer {token}",
        "X-GitHub-Api-Version": "2022-11-28",
    },
)

try:
    with urllib.request.urlopen(req, timeout=20) as response:
        data = json.load(response)
except urllib.error.HTTPError as exc:
    raise SystemExit(
        f"GitHub Actions API HTTP {exc.code} for {repo} at {sha}"
    ) from exc

required = {
    ".github/workflows/test.yml",
    ".github/workflows/test2-validation.yml",
}

latest = {}

for run in data.get("workflow_runs", []):
    path = run.get("path")

    if path not in required:
        continue

    current = latest.get(path)

    if (
        current is None
        or int(run.get("run_attempt") or 0)
        > int(current.get("run_attempt") or 0)
        or int(run.get("id") or 0)
        > int(current.get("id") or 0)
    ):
        latest[path] = {
            "status": run.get("status"),
            "conclusion": run.get("conclusion"),
            "id": run.get("id"),
            "run_attempt": run.get("run_attempt"),
            "html_url": run.get("html_url"),
        }

print(json.dumps(latest, indent=2))

missing = required - set(latest)

if missing:
    raise SystemExit(
        f"Missing exact-SHA workflow runs: {sorted(missing)}"
    )

bad = {
    path: value
    for path, value in latest.items()
    if value["status"] != "completed"
    or value["conclusion"] != "success"
}

if bad:
    raise SystemExit(
        f"Exact-SHA workflows not green: {bad}"
    )

print("EXACT-SHA GITHUB WORKFLOWS: PASS")
PY

if [[ $? -ne 0 ]]; then
    cat "$OUT/github-ci.txt"
    block "github_exact_sha_not_green"
else
    cat "$OUT/github-ci.txt"
fi


cat > "$WORK/vp_property_tests.py" <<'PY'
from copy import deepcopy
import random

from hypothesis import given, settings, strategies as st

from inverted.test2_preregistration import evaluate_primary_verdict


MODELS = ["m1", "m2", "m3"]
TASKS = [f"task-{i}" for i in range(6)]


def rows():
    result = []
    n = 1

    for task_index, task in enumerate(TASKS):
        for model_index, model in enumerate(MODELS):

            result.append({
                "feedback_style": "structured",
                "strategy": "targeted",
                "model": model,
                "task_id": task,
                "success": not (
                    task_index == 5 and model_index == 2
                ),
                "catastrophic": False,
                "cache_hit": False,
                "physical_call_number": n,
                "call_identity": f"T:{model}:{task}",
            })
            n += 1

            result.append({
                "feedback_style": "raw",
                "strategy": "regenerate",
                "model": model,
                "task_id": task,
                "success": model_index == 0,
                "catastrophic": False,
                "cache_hit": False,
                "physical_call_number": n,
                "call_identity": f"C:{model}:{task}",
            })
            n += 1

    return result


def test_exact_grid_is_accepted_as_decidable_structure():
    verdict = evaluate_primary_verdict(rows())

    assert verdict["verdict"] in {
        "SUPPORTED",
        "REFUTED",
        "INCONCLUSIVE",
    }

    assert verdict["models"] == 3
    assert verdict["tasks"] == 6
    assert verdict["n_matched"] == 18
    assert verdict["bootstrap_unit"] == "task_cluster"
    assert verdict["task_clusters"] == 6


def test_one_model_pseudogrid_is_non_decisive():
    data = rows()

    for row in data:
        row["model"] = "only-one-model"

    assert (
        evaluate_primary_verdict(data)["verdict"]
